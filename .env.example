# Continuum AI — Environment Configuration Template
# Copy this file to .env and fill in your actual values for local development.
# In production (Railway), set these environment variables in your project dashboard.
# NEVER commit your actual .env file to Git!

# ==============================================================================
# AI Provider Configuration (Groq / Grok / xAI)
# ==============================================================================
# Obtain key from https://console.groq.com/ or https://console.x.ai/
GROQ_API_KEY=your_groq_or_grok_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Grok API alias (if using xAI Grok directly)
# GROK_API_KEY=your_xai_grok_key_here

# ==============================================================================
# Server & CORS Configuration (FastAPI Backend)
# ==============================================================================
# In production (Railway), $PORT is automatically injected by the platform.
PORT=8000
HOST=0.0.0.0

# Deployed Frontend Origin (e.g. https://your-app.vercel.app)
# Comma-separated list of allowed origins for production CORS
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: Set to true if you want to automatically allow all https://*.vercel.app preview URLs
ALLOW_VERCEL_PREVIEWS=true

# ==============================================================================
# Chrome Extension Authentication Secret (Local Ingestion)
# ==============================================================================
EXTENSION_AUTH_TOKEN=generate_a_random_secure_token_here

# ==============================================================================
# Database Configuration
# ==============================================================================
# Local development uses SQLite in data/sip_discovery.db automatically.
# In Railway production, attach a PostgreSQL service and inject DATABASE_URL:
# DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
